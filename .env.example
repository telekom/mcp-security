# MCP Security Demo Tool - Environment Configuration
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# =============================================================================
# AI Provider Configuration
# =============================================================================

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google AI API Key (optional — enables Gemini models in the model selector)
# Get your API key from: https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# =============================================================================
# Public Environment Variables (accessible in browser)
# Prefix with NEXT_PUBLIC_ to expose to client-side code
# =============================================================================

# Application name displayed in the UI
NEXT_PUBLIC_APP_NAME=MCP Security Dashboard

# Application version
NEXT_PUBLIC_APP_VERSION=0.1.0

# Enable debug mode in development
NEXT_PUBLIC_DEBUG_MODE=false
